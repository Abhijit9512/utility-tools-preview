**Age Calculator**  
```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Age Calculator</title>
  <meta name="description" content="Calculate age from birthdate.">
  <style>
    body {font-family:Arial,Helvetica,sans-serif; max-width:600px; margin:40px auto; padding:20px;}
    input {margin-top:10px; padding:5px;}
    button {margin-top:15px; padding:8px 15px; background:#2563eb;color:white;border:none;border-radius:4px;cursor:pointer;}
    .result {margin-top:20px; font-weight:bold;}
  </style>
</head>
<body>
  <h1>Age Calculator</h1>
  <p>Enter your birthdate (year‑month‑day).</p>
  <input type="date" id="dob">
  <button onclick="calculate()">Calculate</button>
  <div class="result" id="result"></div>

  <script>
    function calculate() {
      const dob = document.getElementById('dob').value;
      if (!dob) { document.getElementById('result').textContent='Please select a date.'; return; }
      const today = new Date();
      const birth = new Date(dob);
      let years = today.getFullYear() - birth.getFullYear();
      const monthDiff = today.getMonth() - birth.getMonth();
      const dayDiff = today.getDate() - birth.getDate();
      if (monthDiff < 0 || (monthDiff === 0 && dayDiff < 0)) years--;
      document.getElementById('result').textContent = `You are ${years} years old.`;
    }
  </script>
</body>
</html>
```

**Percentage Calculator**  
```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Percentage Calculator</title>
  <meta name="description" content="Calculate percentages and discounts.">
