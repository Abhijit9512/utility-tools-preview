  </style>
</head>
<body>
  <h1>JSON Formatter</h1>
  <textarea id="jsonInput" placeholder="{…}"></textarea>
  <button onclick="format()">Format</button>
  <pre id="formatted"></pre>

  <script>
    function format() {
      const raw = document.getElementById('jsonInput').value;
      let parsed;
      try { parsed = JSON.parse(raw); }
      catch (e) { document.getElementById('formatted').textContent='Invalid JSON.'; return; }
      document.getElementById('formatted').textContent = JSON.stringify(parsed, null, 2);
    }
  </script>
