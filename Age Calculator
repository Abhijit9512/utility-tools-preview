**Online Timer**  
```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Online Timer</title>
  <meta name="description" content="Countdown timer for any duration.">
  <style>
    body {font-family:Arial,Helvetica,sans-serif; max-width:600px; margin:40px auto; padding:20px;}
    .timer {font-size:48px; margin:20px 0;}
    button {padding:10px 15px; background:#2563eb;color:white;border:none;border-radius:4px;margin-right:5px;}
  </style>
</head>
<body>
  <h1>Online Timer</h1>
  <div class="timer" id="display">00:00:00</div>
  <input type="number" id="minutes" placeholder="Minutes" min="0">
  <button onclick="startTimer()">Start</button>
  <button onclick="resetTimer()">Reset</button>

  <script>
    let timerId;
    function startTimer() {
      const mins = parseInt(document.getElementById('minutes').value) || 0;
      let remaining = mins * 60;
      clearInterval(timerId);
      timerId = setInterval(() => {
        const h = Math.floor(remaining / 3600);
        const m = Math.floor((remaining % 3600) / 60);
        const s = remaining % 60;
        document.getElementById('display').textContent = `${h.toString().padStart(2,'0')}:${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`;
        if (remaining <= 0) { clearInterval(timerId); alert('Timer finished'); }
        remaining--;
      }, 1000);
    }
    function resetTimer() {
      clearInterval(timerId);
      document.getElementById('display').textContent = '00:00:00';
      document.getElementById('minutes').value = '';
    }
  </script>
</body>
</html>
```

**Stopwatch**  
```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stopwatch</title>
  <meta name="description" content="Simple stopwatch to measure elapsed time.">
  <style>
    body {font-family:Arial,Helvetica,sans-serif; max-width:600px; margin:40px auto; padding:20px;}
    .time {font-size:48px; margin:15px 0;}
    button {padding:10px 15px; background:#2563eb;color:white;border:none;border-radius:4px;margin-right:5px;}
  </style>
</head>
<body>
  <h1>Stopwatch</h1>
  <div class="time" id="time">00:00:00</div>
  <button onclick="start()">Start</button>
  <button onclick="stop()">Stop</button>
  <button onclick="reset()">Reset</button>

  <script>
    let startTime, elapsed = 0, timerId;
    function start() {
      startTime = Date.now() - elapsed;
      timerId = setInterval(update, 10);
    }
    function stop() {
      clearInterval(timerId);
    }
    function reset() {
      clearInterval(timerId);
      elapsed = 0;
      document.getElementById('time').textContent = '00:00:00';
    }
    function update() {
      const now = Date.now();
      elapsed = now - startTime;
      const h = Math.floor(elapsed / 3600000);
      const m = Math.floor((elapsed % 3600000) / 60000);
      const s = Math.floor((elapsed % 60000) / 1000);
      document.getElementById('time').textContent = `${h.toString().padStart(2,'0')}:${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`;
    }
  </script>
</body>
</html>
```

**Pomodoro Timer**  
```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pomodoro Timer</title>
  <meta name="description" content="Work and break timer using the Pomodoro technique.">
  <style>
    body {font-family:Arial,Helvetica,sans-serif; max-width:600px; margin:40px auto; padding:20px;}
    .timer {font-size:48px; margin:15px 0;}
    button {padding:10px 15px; background:#2563eb;color:white;border:none;border-radius:4px;margin-right:5px;}
  </style>
</head>
<body>
  <h1>Pomodoro Timer</h1>
  <p>Standard work interval: 25 minutes, break: 5 minutes.</p>
  <div class="timer" id="display">00:25:00</div>
  <button onclick="decreaseWork()">‑5 min (Work)</button>
  <button onclick="decreaseBreak()">‑5 min (Break)</button>
  <button onclick="startPomodoro()">Start</button>
  <button onclick="reset()">Reset</button>

  <script>
    let workSec = 25 * 60;
    let breakSec = 5 * 60;
    let isRunning = false;
    let currentSec = workSec;
    let timerId;

    function startPomodoro() {
      if (isRunning) return;
      isRunning = true;
      document.getElementById('display').textContent = `00:${String(Math.floor(currentSec/60)).padStart(2,'0')}:${String(currentSec%60).padStart(2,'0')}`;
      timerId = setInterval(() => {
        if (currentSec <= 0) {
          clearInterval(timerId);
          isRunning = false;
          alert('Break time!');
          currentSec = breakSec;
        } else {
          currentSec--;
        }
        const h = Math.floor(currentSec / 3600);
        const m = Math.floor((currentSec % 3600) / 60);
        const s = currentSec % 60;
        document.getElementById('display').textContent = `${h.toString().padStart(2,'0')}:${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`;
        if (h === 0 && m === 0 && s === 0) {
          clearInterval(timerId);
          isRunning = false;
          alert('Break ended – start next work session');
          currentSec = workSec;
        }
      }
    }
    function decreaseWork() { currentSec = Math.max(0, currentSec - 300); }
    function decreaseBreak() { currentSec = Math.max(0, currentSec - 300); }
    function reset() {
      clearInterval(timerId);
      isRunning = false;
      document.getElementById('display').textContent = '00:25:00';
      currentSec = workSec;
    }
  </script>
</body>
</html>
```

